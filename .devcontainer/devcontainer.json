{
  "name": "pyfundamentals",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": true,
          "yaml": true,
          "plaintext": true,
          "markdown": true,
          "python": true
        },
        "github.copilot.chat.useProjectTemplates": true,
        "github.copilot.chat.memory.enabled": true
      }
    }
  },
  "postCreateCommand": "python -m ipykernel install --user --name=pyfundamentals --display-name='Python (pyfundamentals)'",
  "forwardPorts": [8888],
  "containerEnv": {
    "JUPYTER_ENABLE_LAB": "yes"
  }
}